# ResearchMind AI — copy to backend/.env and fill in.
# Optional keys MUST be left empty (not placeholder text) to run in limited mode.

# ── Database ─────────────────────────────────────────────────────────────────
# docker compose overrides this to use its own Postgres container.
# Quick local run without Docker:  DATABASE_URL=sqlite:///./researchmind.db
DATABASE_URL=postgresql://researchmind:devpassword@localhost:5432/researchmind_db

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set this before sharing a public link: testers need it to create an account
INVITE_CODE=

# ── AI ───────────────────────────────────────────────────────────────────────
# Required: OpenAI (used for embeddings, and for analysis if no Claude key)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
# Optional: when set, Claude does the analysis, chat and writing
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── Paper sources (all free) ─────────────────────────────────────────────────
# Leave empty for limited mode; add free keys later for more results.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=
# Contact emails sent politely to the APIs (recommended)
OPENALEX_EMAIL=
PUBMED_EMAIL=
CROSSREF_EMAIL=

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ResearchMindAI
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_PAPERS_PER_SESSION=40
MAX_UPLOAD_SIZE=52428800

# Never enable for real use: fake papers/LLM for tests and UI checks only
OFFLINE_DEMO=false

# ── Redis / Celery (not used by the POC yet) ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
