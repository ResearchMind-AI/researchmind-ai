# ─── Production environment template ─────────────────────────────────────────
# Copy to .env on the EC2 instance at /opt/researchmind/.env
# Never commit the actual .env file.

# ── Database (RDS) ────────────────────────────────────────────────────────────
# Get the endpoint from: terraform output rds_endpoint
DATABASE_URL=postgresql://researchmind:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/researchmind_db

# ── Redis (local container) ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=<generate with: openssl rand -hex 32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
INVITE_CODE=<code testers need to sign up>

# ── AI ───────────────────────────────────────────────────────────────────────
# OpenAI is required (embeddings). Claude is used for analysis when set,
# otherwise OpenAI CHAT_MODEL is used.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CHAT_MODEL=gpt-4o-mini

# ── Academic APIs (all free; leave keys empty to run in limited mode) ────────
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
PUBMED_API_KEY=
OPENALEX_EMAIL=you@example.com
PUBMED_EMAIL=you@example.com
CROSSREF_EMAIL=you@example.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=ResearchMind AI
APP_VERSION=1.0.0
DEBUG=false
CORS_ORIGINS=https://your-domain.com
OFFLINE_DEMO=false

# ── File storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800  # 50MB

# ── Discovery ────────────────────────────────────────────────────────────────
MAX_PAPERS_PER_SESSION=40

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Image tags (managed automatically by the deploy workflow) ─────────────────
BACKEND_IMAGE=<ECR_REGISTRY>/researchmind-backend:latest
FRONTEND_IMAGE=<ECR_REGISTRY>/researchmind-frontend:latest
